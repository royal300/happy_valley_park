#!/usr/bin/expect

# Configuration
set timeout 300
set host "93.127.206.52"
set user "root"
set password "Royal300@2026"
set script "./deploy.sh"

spawn $script

expect {
    "Are you sure you want to continue connecting" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}

puts "\n🎉 Deployment finished!"
