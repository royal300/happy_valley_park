#!/bin/bash

# Auto-load the deployment secrets
if [ -f ".env.deploy" ]; then
    source .env.deploy
else
    echo "❌ Error: .env.deploy file not found! Please create it with your credentials."
    exit 1
fi

# Export all vars so expect can read them via $env()
export DEPLOY_USER DEPLOY_HOST DEPLOY_PASSWORD DEPLOY_DB_USER DEPLOY_DB_PASS DEPLOY_DB_NAME DEPLOY_DB_HOST

echo "🚀 Connecting to $DEPLOY_USER@$DEPLOY_HOST ..."

# Run expect inline — uses exported env vars via $env()
expect << EOF
set timeout 300
set host   "\$env(DEPLOY_HOST)"
set user   "\$env(DEPLOY_USER)"
set pass   "\$env(DEPLOY_PASSWORD)"

spawn bash deploy.sh

expect {
    "Are you sure you want to continue connecting" {
        send "yes\r"
        exp_continue
    }
    -re {[Pp]assword:} {
        send "\$pass\r"
        exp_continue
    }
    eof
}

puts "\n🎉 Deployment finished!"
EOF
