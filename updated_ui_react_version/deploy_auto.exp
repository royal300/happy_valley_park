#!/bin/bash

# Auto-load the deployment secrets
if [ -f ".env.deploy" ]; then
    source .env.deploy
else
    echo "❌ Error: .env.deploy file not found! Please create it with your credentials."
    exit 1
fi

# Run the expect script to automate SSH password entry
expect << 'EOF'
set timeout 300
set host $env(DEPLOY_HOST)
set user $env(DEPLOY_USER)
set password $env(DEPLOY_PASSWORD)
set script "./deploy.sh"

spawn $script

expect {
    "Are you sure you want to continue connecting" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}

puts "\n🎉 Deployment finished!"
EOF
